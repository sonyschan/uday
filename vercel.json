{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "my.uday.gift" }],
      "destination": "https://app.uday.gift/:path*",
      "permanent": true
    },
    {
      "source": "/c",
      "has": [{ "type": "host", "value": "uday.gift" }],
      "destination": "https://app.uday.gift/c",
      "permanent": false
    },
    {
      "source": "/c/:path*",
      "has": [{ "type": "host", "value": "uday.gift" }],
      "destination": "https://app.uday.gift/c/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/c", "destination": "/index.html" },
    { "source": "/c/:slug", "destination": "/index.html" },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "uday.gift" }],
      "destination": "/land.html"
    }
  ]
}
